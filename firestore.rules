rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isValidUser(data, userId) {
      return data.id == userId
        && data.email is string && data.email.size() > 0 && data.email.size() <= 256
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 128
        && data.createdAt is string;
    }

    function isValidTask(data, userId) {
      return data.authorUid == userId
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.title is string && data.title.size() > 0 && data.title.size() <= 256
        && data.directive is string && data.directive.size() > 0 && data.directive.size() <= 10000
        && data.status is string && data.status.size() > 0 && data.status.size() <= 64;
    }

    function isValidSession(data, userId) {
      return data.authorUid == userId
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.title is string && data.title.size() > 0 && data.title.size() <= 256
        && data.activeEntityId is string && data.activeEntityId.size() > 0 && data.activeEntityId.size() <= 64;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(request.resource.data, userId);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(request.resource.data, userId);
      allow delete: if isOwner(userId);

      match /tasks/{taskId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(taskId) && isValidTask(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidId(taskId) && isValidTask(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }

      match /sessions/{sessionId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(sessionId) && isValidSession(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidId(sessionId) && isValidSession(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
